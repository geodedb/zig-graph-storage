.{
    .name = .graph_storage,
    .version = "0.4.30",
    .fingerprint = 0x713d4f134b894cf5,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .wal = .{
            // The content hash + commit SHA are the authoritative pin. The
            // human-readable `ref` tag (v0.1.5) may trail the version declared
            // by the upstream build.zig.zon at that commit (wal-0.1.4); the
            // label mismatch originates upstream and is expected.
            // v0.1.24 (SONNY-6620/6622): init and compact refuse, and leave
            // untouched, a log they cannot decode (WalEncryptionMismatch,
            // WalAuthFailed, WalCorrupted) instead of truncating it; only a
            // genuine torn tail is truncated. Moves thread_pool to v0.2.11.
            // v0.1.25: truncateAfter fails closed the same way (graph-storage
            // does not call it). Same thread_pool v0.2.11.
            .url = "git+https://gitlab.com/devnw/zig/wal.git?ref=v0.1.27#e8d1c51ea00e7788fe950e6f3251c48e8852d2bc",
            .hash = "wal-0.1.27-EqPqpqU_CAB-RfhJaHAM2nOpRpSxl6sykpzcdKXPuKpd",
        },
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git?ref=v0.1.10#5547a8a0d86c67315d292f81411f6237ee61cf5c",
            .hash = "uuid-0.1.10-tL1iroznHACRKPV4rc3sSf8tJtvHw8VfF-Btd4F1giHh",
        },
        .thread_pool = .{
            // v0.2.11: the version wal v0.1.24 pins (no diamond).
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.11#666b7ac0cc8b92d5773df5e79ea4fd421bd77e99",
            .hash = "thread_pool-0.2.11-11B1Bk2GegC5mn18xNrkmF0lMrgrWqijO7PXmftrkuSe",
        },
        .otel = .{
            // The content hash + commit SHA are the authoritative pin. The
            // human-readable `ref` tag (v0.1.8) may trail the version declared
            // by the upstream build.zig.zon at that commit (otel-0.1.7); the
            // label mismatch originates upstream and is expected.
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "examples",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
